# =======================================================
# 1. GENERATED FILES (DO NOT COMMIT)
# =======================================================

# Node.js (CRITICAL: Saves gigabytes of space)
node_modules/
/frontend/node_modules/
/frontend/dist/

# Python cache and temporary environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Virtual Environments (General/Local)
venv/
env/
.venv/
research_env/ 

# =======================================================
# 2. LOCAL DATA AND SECRETS
# =======================================================

# Environment Variables and Secrets
.env
.env.*

# Logs and local databases
*.log
/logs/

# Local Audit and Diff Logs
*audit*.txt
*diff*.txt
last_commit_changes.txt

# =======================================================
# 3. RESEARCH LABORATORY (NEW ARCHITECTURE)
# =======================================================

# CRITICAL: Ignore all heavy datasets (Raw & Processed)
/research/data/raw/
/research/data/processed/

# CRITICAL: Ignore local weights and massive experimental folders
/research/models/*/weights/
/research/models/*/experiment_test_2/

# Universal Deep Learning Binary Extensions
*.pt
*.pth
*.npz
*.npy
*.onnx
*.task
*.zip

# Jupyter Notebooks and Checkpoints (Unless explicitly tracked)
*.ipynb
.ipynb_checkpoints/

# Specific Public Datasets
**/utkinect/

# Ignore auto-generated research plots and evaluation images
/research/models/**/*.png

# =======================================================
# 4. LEGACY ARCHIVES
# =======================================================
/backend/mis_fotos/
/gun-and-knife-dataset/
/backend/referencia_mauricio.npy

# =======================================================
# 5. OS/IDE Files
# =======================================================
.DS_Store
Thumbs.db
.vscode/